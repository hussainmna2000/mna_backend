# Environment Configuration for MNA Real Estate & Construction Backend
APP_NAME="MNA Real Estate & Construction"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL in production; SQLite fallback in local development)
DATABASE_URL="postgresql://mna_user:your_password@localhost:5432/mna_db"

# Security & JWT Tokens
SECRET_KEY="generate-a-strong-32-byte-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://mna-realestate.vercel.app"]

# Initial Super-Administrator Provisioning
ADMIN_EMAIL="admin@mna-realestate.com"
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"
ADMIN_NAME="MNA Principal Director"
